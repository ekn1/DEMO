# SCENTS/WISMO Production Environment Configuration Template
# Copy this file to .env and fill in real values before deployment.

# ==================== Core Configuration ====================
SCENTS_API_TOKEN=dev-token
SCENTS_DB_PATH=/app/data/scents.sqlite
SCENTS_SERVICE_NAME=scents-api

# ==================== TLS Configuration ====================
SCENTS_TLS_ENABLED=false
SCENTS_TLS_CERT=/etc/nginx/certs/scents.crt
SCENTS_TLS_KEY=/etc/nginx/certs/scents.key
SCENTS_TLS_MIN_VERSION=TLSv1.2

# ==================== Tracing & Observability ====================
SCENTS_TRACING_ENABLED=false
SCENTS_TRACING_EXPORTER=console
SCENTS_TRACING_SAMPLE_RATIO=1.0

# ==================== Billing / Stripe ====================
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE

# ==================== OSINT Connectors ====================
OSINT_REAL_CONNECTORS=false
OSINT_CACHE_TTL=300
OSINT_NEWS_RSS_URL=https://feeds.bbci.co.uk/news/world/africa/rss.xml
OSINT_TENDER_API=https://tenders.go.ke/api/v1
OSINT_FINANCIAL_API=https://open.er-api.com/v6/latest
OSINT_GAZETTE_API=https://kenyalaw.org/api/gazettes

# ==================== OSINT API Keys (optional) ====================
# NEWS_API_KEY=your_news_api_key
# TENDER_API_KEY=your_tender_api_key
# WEATHER_API_KEY=your_weather_api_key
# TRAFFIC_API_KEY=your_traffic_api_key

# ==================== WISMO Service URLs ====================
SCENTS_API_URL=http://scents-api:8080
WISMO_PORT=3000
WISMO_OSINT_PORT=3001

# ==================== Redis (for caching/sessions) ====================
REDIS_URL=redis://redis:6379/0

# ==================== Email / Notifications ====================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASS=your_smtp_password
ALERT_EMAIL_TO=ops@example.com

# ==================== Deployment ====================
ENVIRONMENT=production
LOG_LEVEL=info
